<?xml version="1.0" encoding="utf-8"?>
<!-- RESQGO adaptive-icon background: solid brand terracotta with a subtle
     radial lift so the mark reads on both light and dark launcher walls. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#D2691E"
        android:pathData="M0,0h108v108h-108z" />

    <!-- Soft highlight (top-left) -->
    <path
        android:pathData="M-20,-20 L128,-20 L128,54 L-20,128 Z"
        android:fillAlpha="0.14">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFFFFFF" />
                <item android:offset="1.0" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
