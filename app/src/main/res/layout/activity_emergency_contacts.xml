<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/resqgo_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Emergency Contacts"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/resqgo_text_primary"
            android:layout_marginTop="32dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Up to 3 contacts will receive SOS alerts"
            android:textSize="14sp"
            android:textColor="@color/resqgo_text_secondary"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp"/>

        <!-- Contact 1 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_contact_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/resqgo_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:orientation="vertical">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        
                        <TextView
                            android:id="@+id/tv_contact_1_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Name"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/resqgo_text_primary"/>
                            
                        <TextView
                            android:id="@+id/tv_contact_1_phone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Phone"
                            android:textSize="14sp"
                            android:textColor="@color/resqgo_text_secondary"
                            android:layout_marginTop="2dp"/>
                            
                        <TextView
                            android:id="@+id/tv_contact_1_relation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Relation"
                            android:textSize="12sp"
                            android:textColor="@color/resqgo_primary"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                    
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:orientation="vertical">
                        
                        <TextView
                            android:id="@+id/tv_contact_1_primary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PRIMARY"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="@color/resqgo_success"
                            android:visibility="gone"/>
                    </LinearLayout>
                </LinearLayout>
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">
                    
                    <Button
                        android:id="@+id/btn_edit_contact_1"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="Edit"
                        android:backgroundTint="@color/resqgo_surface2"
                        android:textColor="@color/resqgo_text_primary"
                        android:textSize="13sp"
                        app:cornerRadius="8dp"/>
                        
                    <Button
                        android:id="@+id/btn_delete_contact_1"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="Remove"
                        android:backgroundTint="@color/resqgo_alert"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        app:cornerRadius="8dp"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Contact 2 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_contact_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/resqgo_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:orientation="vertical">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        
                        <TextView
                            android:id="@+id/tv_contact_2_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Name"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/resqgo_text_primary"/>
                            
                        <TextView
                            android:id="@+id/tv_contact_2_phone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Phone"
                            android:textSize="14sp"
                            android:textColor="@color/resqgo_text_secondary"
                            android:layout_marginTop="2dp"/>
                            
                        <TextView
                            android:id="@+id/tv_contact_2_relation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Relation"
                            android:textSize="12sp"
                            android:textColor="@color/resqgo_primary"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                    
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:orientation="vertical">
                        
                        <TextView
                            android:id="@+id/tv_contact_2_primary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PRIMARY"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="@color/resqgo_success"
                            android:visibility="gone"/>
                    </LinearLayout>
                </LinearLayout>
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">
                    
                    <Button
                        android:id="@+id/btn_edit_contact_2"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="Edit"
                        android:backgroundTint="@color/resqgo_surface2"
                        android:textColor="@color/resqgo_text_primary"
                        android:textSize="13sp"
                        app:cornerRadius="8dp"/>
                        
                    <Button
                        android:id="@+id/btn_delete_contact_2"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="Remove"
                        android:backgroundTint="@color/resqgo_alert"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        app:cornerRadius="8dp"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Contact 3 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_contact_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/resqgo_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:orientation="vertical">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        
                        <TextView
                            android:id="@+id/tv_contact_3_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Name"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/resqgo_text_primary"/>
                            
                        <TextView
                            android:id="@+id/tv_contact_3_phone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Phone"
                            android:textSize="14sp"
                            android:textColor="@color/resqgo_text_secondary"
                            android:layout_marginTop="2dp"/>
                            
                        <TextView
                            android:id="@+id/tv_contact_3_relation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Relation"
                            android:textSize="12sp"
                            android:textColor="@color/resqgo_primary"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                    
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:orientation="vertical">
                        
                        <TextView
                            android:id="@+id/tv_contact_3_primary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PRIMARY"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="@color/resqgo_success"
                            android:visibility="gone"/>
                    </LinearLayout>
                </LinearLayout>
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">
                    
                    <Button
                        android:id="@+id/btn_edit_contact_3"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="Edit"
                        android:backgroundTint="@color/resqgo_surface2"
                        android:textColor="@color/resqgo_text_primary"
                        android:textSize="13sp"
                        app:cornerRadius="8dp"/>
                        
                    <Button
                        android:id="@+id/btn_delete_contact_3"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="Remove"
                        android:backgroundTint="@color/resqgo_alert"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        app:cornerRadius="8dp"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnAddContact"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="@string/add_contact"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="@color/resqgo_primary"
            android:textColor="@color/white"
            app:cornerRadius="12dp"/>

    </LinearLayout>
</ScrollView>
