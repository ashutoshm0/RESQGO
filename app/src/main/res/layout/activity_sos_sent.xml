<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:clipToPadding="false"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="28dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- SOS Title -->
        <TextView
            android:id="@+id/tvSosTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🚨 SOS Alert Sent"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="?attr/colorError"
            android:layout_marginTop="40dp"
            android:gravity="center"/>

        <!-- Info Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvContactsNotified"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Contacts notified"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnBackground"/>

                <TextView
                    android:id="@+id/tvLocationSent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Location: --"
                    android:textSize="13sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginTop="8dp"/>

                <TextView
                    android:id="@+id/tvMapLink"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍 Open in Google Maps"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginTop="8dp"
                    android:clickable="true"
                    android:focusable="true"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Live delivery status — every SOS channel reports its real outcome
             here. The spec forbids silent failure, so nothing claims success
             until the platform confirms it. -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="DELIVERY STATUS"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/deliveryStatusContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />

                <Button
                    android:id="@+id/btnSmsFallback"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
                    android:backgroundTint="?attr/colorError"
                    android:text="✉️ Open SMS app with the alert"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:cornerRadius="12dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Call Button -->
        <Button
            android:id="@+id/btnCallContact"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="20dp"
            android:text="📞 Call Emergency Contact Now"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="?attr/colorPrimary"
            android:textColor="@color/white"
            app:cornerRadius="12dp"/>

        <!-- Nearest Hospital -->
        <Button
            android:id="@+id/btnNearestHospital"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:text="🏥 Find Nearest Hospital"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="?attr/colorOnSurfaceVariant"
            android:textColor="@color/white"
            app:cornerRadius="12dp"/>

        <!-- WhatsApp buttons (dynamically added) -->
        <LinearLayout
            android:id="@+id/whatsappButtonsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp"/>

        <!-- I'm Safe Button -->
        <Button
            android:id="@+id/btnImSafe"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="32dp"
            android:text="✅ I'm Safe — Cancel Alert"
            android:textSize="15sp"
            android:backgroundTint="?attr/colorSurface"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:cornerRadius="12dp"/>

    </LinearLayout>
</ScrollView>
