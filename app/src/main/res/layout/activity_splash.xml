<?xml version="1.0" encoding="utf-8"?>
<!-- Branded startup surface (Change 7). The mark and wordmark animate in while
     SplashActivity does real initialisation work; the status line reports what
     is actually being prepared rather than showing a generic spinner. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="32dp">

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Madhubani chakra sits behind the mark as a subtle cultural accent -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/imgChakra"
                android:layout_width="230dp"
                android:layout_height="230dp"
                android:layout_gravity="center"
                android:alpha="0"
                android:contentDescription="@null"
                android:src="@drawable/bg_mandala" />

            <ImageView
                android:id="@+id/imgSplashMark"
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_circle_primary"
                android:contentDescription="@string/app_name"
                android:padding="26dp"
                android:scaleX="0.7"
                android:scaleY="0.7"
                android:alpha="0"
                android:src="@drawable/ic_splash_mark" />
        </FrameLayout>

        <!-- Wordmark -->
        <LinearLayout
            android:id="@+id/wordmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:alpha="0"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.02"
                android:text="RES"
                android:textColor="?attr/colorOnBackground"
                android:textSize="42sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.02"
                android:text="Q"
                android:textColor="?attr/colorPrimary"
                android:textSize="42sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.02"
                android:text="GO"
                android:textColor="?attr/colorOnBackground"
                android:textSize="42sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0"
            android:letterSpacing="0.22"
            android:text="@string/app_tagline"
            android:textAllCaps="true"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Real initialisation progress, not a decorative spinner -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressInit"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:max="100"
            app:indicatorColor="?attr/colorPrimary"
            app:trackColor="?attr/colorOutline"
            app:trackCornerRadius="3dp"
            app:trackThickness="4dp" />

        <TextView
            android:id="@+id/tvInitStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="56dp"
            android:gravity="center"
            android:text="@string/init_starting"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
