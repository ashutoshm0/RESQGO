<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/resqgo_bg"
        android:padding="32dp"
        android:orientation="vertical">
        
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🆘"
            android:textSize="64sp"
            android:gravity="center"/>
            
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_contact_title"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/resqgo_text_primary"
            android:layout_marginTop="16dp"
            android:gravity="center"/>
            
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_contact_subtitle"
            android:textSize="15sp"
            android:textColor="@color/resqgo_text_secondary"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.4"/>
            
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            app:cardBackgroundColor="@color/resqgo_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:orientation="vertical">
                
                <EditText
                    android:id="@+id/etContactName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/contact_name_hint"
                    android:textColor="@color/resqgo_text_primary"
                    android:textColorHint="@color/resqgo_text_secondary"
                    android:inputType="textPersonName"
                    android:textSize="16sp"
                    android:background="@android:color/transparent"
                    android:layout_marginBottom="16dp"/>
                    
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/resqgo_divider"/>
                    
                <EditText
                    android:id="@+id/etContactPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/contact_phone_hint"
                    android:textColor="@color/resqgo_text_primary"
                    android:textColorHint="@color/resqgo_text_secondary"
                    android:inputType="phone"
                    android:textSize="16sp"
                    android:background="@android:color/transparent"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"/>
                    
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/resqgo_divider"/>
                    
                <EditText
                    android:id="@+id/etContactRelation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/contact_relation_hint"
                    android:textColor="@color/resqgo_text_primary"
                    android:textColorHint="@color/resqgo_text_secondary"
                    android:inputType="textCapSentences"
                    android:textSize="16sp"
                    android:background="@android:color/transparent"
                    android:layout_marginTop="16dp"/>
                    
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        
        <Button
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="28dp"
            android:text="@string/btn_next"
            android:backgroundTint="@color/resqgo_primary"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"/>
            
    </LinearLayout>
</ScrollView>
