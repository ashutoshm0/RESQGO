<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ══════════════════════════════════════════════════════════════════
         RESQGO Brand Palette
         Light  = "Palette 2 — Earthy Ochre"    (warm, friendly, reliable)
         Dark   = "Palette 9 — Midnight Minimal" (premium, clean, focused)
         Values taken from the approved design board.
         ══════════════════════════════════════════════════════════════════ -->

    <!-- Brand constants (identical in both themes) -->
    <color name="brand_terracotta">#D2691E</color>  <!-- Light primary  -->
    <color name="brand_sand">#F1D9B7</color>        <!-- Light accent   -->
    <color name="brand_ink">#2E2E2E</color>         <!-- Light text     -->
    <color name="brand_cream">#FAF5ED</color>       <!-- Light bg       -->
    <color name="brand_obsidian">#080B0B</color>    <!-- Dark bg        -->
    <color name="brand_slate">#374151</color>       <!-- Dark accent    -->
    <color name="brand_gold">#FACC15</color>        <!-- Dark primary   -->
    <color name="brand_snow">#F5F5F5</color>        <!-- Dark text      -->
    <color name="brand_sos">#D32F2F</color>         <!-- SOS red (both) -->

    <!-- ── Light Theme (Earthy Ochre) ─────────────────────────────────── -->
    <color name="md_theme_light_primary">#D2691E</color>
    <color name="md_theme_light_onPrimary">#FFFFFF</color>
    <color name="md_theme_light_secondary">#A65B2F</color>
