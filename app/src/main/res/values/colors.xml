    <color name="md_theme_light_surfaceVariant">#F1D9B7</color>
    <color name="md_theme_light_onSurfaceVariant">#7A6A57</color>
    <color name="md_theme_light_error">#D32F2F</color>
    <color name="md_theme_light_onError">#FFFFFF</color>
    <color name="md_theme_light_outline">#E3D5C0</color>

    <!-- ── Dark Theme (Midnight Minimal) ──────────────────────────────── -->
    <color name="md_theme_dark_primary">#FACC15</color>
    <color name="md_theme_dark_onPrimary">#080B0B</color>
