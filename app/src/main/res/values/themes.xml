<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme (DayNight allows automatic light/dark switching).
         Light = "Palette 2 — Earthy Ochre" from the RESQGO design board. -->
    <style name="Theme.RESQGO" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="homeHeaderBackground">@drawable/bg_madhubani_header</item>

        <item name="colorPrimary">@color/md_theme_light_primary</item>
        <item name="colorOnPrimary">@color/md_theme_light_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_light_surfaceVariant</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_light_onBackground</item>

        <item name="colorSecondary">@color/md_theme_light_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_light_onSecondary</item>

        <item name="colorError">@color/md_theme_light_error</item>
        <item name="colorOnError">@color/md_theme_light_onError</item>
        <item name="colorErrorContainer">#FDE8E6</item>
        <item name="colorOnErrorContainer">#8C1D18</item>

        <item name="android:colorBackground">@color/md_theme_light_background</item>
        <item name="colorOnBackground">@color/md_theme_light_onBackground</item>

        <item name="colorSurface">@color/md_theme_light_surface</item>
        <item name="colorOnSurface">@color/md_theme_light_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_light_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_light_onSurfaceVariant</item>
        <item name="colorOutline">@color/md_theme_light_outline</item>

        <!-- System UI -->
        <item name="android:statusBarColor">@color/md_theme_light_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/md_theme_light_background</item>

        <!-- Basic Text Color Mapping for Legacy Views -->
        <item name="android:textColorPrimary">@color/md_theme_light_onBackground</item>
        <item name="android:textColorSecondary">@color/md_theme_light_onSurfaceVariant</item>
    </style>

    <style name="Theme.RESQGO.Splash" parent="Theme.RESQGO">
        <item name="android:windowBackground">@color/md_theme_light_background</item>
    </style>

    <style name="Theme.RESQGO.Confirmation" parent="Theme.RESQGO">
        <!-- Dark obsidian for the confirmation screen regardless of light/dark mode for seriousness -->
        <item name="android:windowBackground">#0D0F12</item>
        <item name="android:statusBarColor">#0D0F12</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/white</item>
    </style>

    <style name="Theme.RESQGO.Riding" parent="Theme.RESQGO">
        <item name="android:windowBackground">@color/md_theme_light_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <!-- ── Reusable component styles ──────────────────────────────────── -->

    <style name="Widget.RESQGO.SectionLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">22dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.09</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Widget.RESQGO.OptionSwitch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">?attr/colorOnBackground</item>
    </style>

    <!-- Route-choice card: label on top, ETA underneath (see design board).
         MaterialCardView does not push its checked state down to children, so
         RidingActivity tints the two labels when the selection changes. -->
    <style name="Widget.RESQGO.RouteCard" parent="Widget.Material3.CardView.Outlined">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:minWidth">84dp</item>
        <item name="android:checkable">true</item>
        <item name="cardBackgroundColor">@color/chip_selector_background</item>
        <item name="strokeColor">@color/chip_selector_stroke</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">3dp</item>
        <item name="checkedIcon">@null</item>
    </style>

    <style name="Widget.RESQGO.RouteCardContent" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">84dp</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">8dp</item>
    </style>

    <style name="Widget.RESQGO.RouteCardTitle" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnBackground</item>
    </style>

    <style name="Widget.RESQGO.RouteCardEta" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:text">--</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Route-choice chip: label on top, ETA underneath (see design board). -->
    <style name="Widget.RESQGO.RouteChip" parent="Widget.Material3.Chip.Filter">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/chip_selector_text</item>
        <item name="chipBackgroundColor">@color/chip_selector_background</item>
        <item name="chipStrokeColor">@color/chip_selector_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipMinHeight">46dp</item>
        <item name="chipCornerRadius">10dp</item>
        <item name="chipStartPadding">10dp</item>
        <item name="chipEndPadding">10dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipIconVisible">false</item>
    </style>

    <!-- Crash-timer chip: deliberately large so it is easy to hit with gloves on. -->
    <style name="Widget.RESQGO.TimerChip" parent="Widget.Material3.Chip.Filter">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/chip_selector_text</item>
        <item name="chipBackgroundColor">@color/chip_selector_background</item>
        <item name="chipStrokeColor">@color/chip_selector_stroke</item>
        <item name="chipStrokeWidth">1.5dp</item>
        <item name="chipMinHeight">54dp</item>
        <item name="chipCornerRadius">14dp</item>
        <item name="chipStartPadding">16dp</item>
        <item name="chipEndPadding">16dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="ensureMinTouchTargetSize">true</item>
    </style>
</resources>
